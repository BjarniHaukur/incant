<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime is required for notarization, and under it the
	     microphone needs asking for explicitly. Everything else Incant does is
	     gated by TCC rather than by entitlements: the Accessibility API it uses
	     to place text, and the synthetic key events it posts as a fallback, are
	     granted by the user in System Settings, not by this file. Incant is
	     deliberately not sandboxed — an app whose job is typing into other
	     applications cannot be. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
